<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_picker_dialog"
    android:orientation="vertical">

    <TextView
        android:id="@+id/updateDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp"
        android:text="@string/new_version_detected"
        android:textColor="@color/error_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nav_divider" />

    <TextView
        android:id="@+id/updateVersionName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:textColor="@color/error_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateChangelog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_picker_wheel"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:textColor="@color/nav_unselected"
        android:textSize="13sp"
        android:textStyle="normal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/nav_divider" />

    <TextView
        android:id="@+id/updateNowButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="@string/update_now"
        android:textColor="@color/nav_selected"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nav_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/remindNextStartupButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/remind_next_startup"
            android:textColor="@color/nav_unselected"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/nav_divider" />

        <TextView
            android:id="@+id/ignoreThisUpdateButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/ignore_this_update"
            android:textColor="@color/nav_unselected"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
